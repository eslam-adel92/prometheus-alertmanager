# =============================================================================
# Monitoring Agent — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# These variables control which host ports the agent services bind to,
# where Promtail sends logs, and how this server identifies itself.
# =============================================================================

# Port for Node Exporter (host-level metrics)
NODE_EXPORTER_PORT=9100

# Port for cAdvisor (container-level metrics)
CADVISOR_PORT=8080

# Central Loki URL — where Promtail pushes logs
# Replace with the central server's IP/hostname and Loki port
LOKI_URL=http://<CENTRAL_SERVER_IP>:3100

# Server name — identifier for this server in log labels
# Used to filter logs by server in Grafana dashboards
SERVER_NAME=<server-name>
