# =============================================================================
# Monitoring Agent — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# These variables control which host ports the agent services bind to.
# Change them if the defaults (9100, 8080) conflict with services on this host.
# =============================================================================

# Port for Node Exporter (host-level metrics)
NODE_EXPORTER_PORT=9100

# Port for cAdvisor (container-level metrics)
CADVISOR_PORT=8080
